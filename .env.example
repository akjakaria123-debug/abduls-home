# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, NEVER exposed to the client. Used later
# (cron publishing, Stripe webhooks, admin dashboard) via lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Used to build email confirmation / OAuth redirect URLs. Must match a URL
# registered in Supabase Auth → URL Configuration → Redirect URLs, and the
# Meta app's Valid OAuth Redirect URIs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Meta / Facebook ───────────────────────────────────────────────────────
# From your app at developers.facebook.com → Settings → Basic.
# Server-only: the secret must never reach the browser.
META_APP_ID=
META_APP_SECRET=
# Optional. Defaults to v21.0. Bump when Meta deprecates that version —
# see developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION=
# Required ONLY if the app uses "Facebook Login for Business" rather than
# plain "Facebook Login". That product ignores the requested scopes and
# reads the permissions from a configuration instead: create one under
# Facebook Login for Business → Configurations, give it the Page
# permissions, and put its ID here. Leave blank for plain Facebook Login.
META_LOGIN_CONFIG_ID=

# ── Stripe ────────────────────────────────────────────────────────────────
# Developers → API keys. Use test keys (sk_test_…) until you go live.
# Server-only: never expose the secret key to the browser.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → signing secret (whsec_…).
# Local testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints its own signing secret — use that one while developing.
STRIPE_WEBHOOK_SECRET=

# ── Cron ──────────────────────────────────────────────────────────────────
# Guards /api/cron/publish, which posts to real Facebook Pages. Vercel
# sends this as "Authorization: Bearer <CRON_SECRET>" on scheduled runs.
# Without it the endpoint refuses every request.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────
# Which vendor writes the captions: "gemini" or "openai". Both speak the
# same API, so switching is this line plus the matching key below.
#
#   gemini — Google AI Studio (aistudio.google.com/apikey). Has a free
#            tier that needs no payment card. Set GEMINI_API_KEY.
#   openai — platform.openai.com. Pay-as-you-go, needs a card on file.
#            Set OPENAI_API_KEY.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional. Overrides the vendor's default model
# (gemini-3.6-flash / gpt-4o-mini) — both are cheap and good enough for
# captions, so leave this blank unless you have a reason.
AI_MODEL=

# ── Encryption ────────────────────────────────────────────────────────────
# Encrypts Facebook access tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Rotating this invalidates every stored token — users must reconnect.
TOKEN_ENCRYPTION_KEY=
